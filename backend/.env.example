# Server
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_password
DB_DATABASE=nestjs_auth
# 仅开发环境可设为 true，生产环境必须为 false
DB_SYNCHRONIZE=false

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# Logging
# LOG_LEVEL: ERROR | WARN | LOG | DEBUG | VERBOSE
LOG_LEVEL=DEBUG
